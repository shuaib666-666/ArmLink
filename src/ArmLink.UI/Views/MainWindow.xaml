<Window x:Class="ArmLink.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:ArmLink.UI.Behaviors"
        xmlns:vm="clr-namespace:ArmLink.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ArmLink — 虛擬機械手臂控制台"
        Width="1180" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F141A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- 深色工控風格：低亮度背景 + 高對比文字，長時間監控眼睛不累 -->
        <SolidColorBrush x:Key="PanelBrush" Color="#161D25" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#28323D" />
        <SolidColorBrush x:Key="TextBrush" Color="#DCE3EA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8494A4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />

        <!-- 卡片外框 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- 一般按鈕 -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2A36" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#31404F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#29394A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33475C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 點動按鈕 -->
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#223140" />
        </Style>

        <!-- 緊急停止 -->
        <Style x:Key="EStopButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#B71C1C" />
            <Setter Property="BorderBrush" Value="#FF5252" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7F0000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字輸入框 -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#31404F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadoutLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 標題 -->
            <RowDefinition Height="Auto" />  <!-- 連線控制區 -->
            <RowDefinition Height="*" />     <!-- 主內容 -->
            <RowDefinition Height="Auto" />  <!-- 狀態列 -->
        </Grid.RowDefinitions>

        <!-- ============ 標題 ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ArmLink" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding MockServerText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Text="WPF + MVVM Toolkit + async Socket + 軟體測試框架"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </DockPanel>

        <!-- ============ 連線控制區 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="連線控制" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="IP" Style="{StaticResource ReadoutLabel}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="132"
                             Style="{StaticResource DarkTextBox}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Port" Style="{StaticResource ReadoutLabel}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80"
                             Style="{StaticResource DarkTextBox}" />
                </StackPanel>

                <Button Grid.Column="3" Content="連線" Command="{Binding ConnectCommand}" Style="{StaticResource DarkButton}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="斷線" Command="{Binding DisconnectCommand}" Style="{StaticResource DarkButton}" Margin="0,0,16,0" />

                <Ellipse Grid.Column="6" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"
                         Fill="{Binding ConnectionBrush}" Stroke="#2B3644" StrokeThickness="1" />
                <TextBlock Grid.Column="7" Text="{Binding ConnectionText}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" MinWidth="90" />
            </Grid>
        </Border>

        <!-- ============ 主內容 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- 左欄：點動 + 狀態 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 手動點動區 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="手動點動 Jog Control" Style="{StaticResource CardTitle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="− X" Command="{Binding JogCommand}" CommandParameter="X-" Style="{StaticResource JogButton}" Margin="0,0,10,0" />
                                <Button Content="X +" Command="{Binding JogCommand}" CommandParameter="X+" Style="{StaticResource JogButton}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="− Y" Command="{Binding JogCommand}" CommandParameter="Y-" Style="{StaticResource JogButton}" Margin="0,0,10,0" />
                                <Button Content="Y +" Command="{Binding JogCommand}" CommandParameter="Y+" Style="{StaticResource JogButton}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="− Z" Command="{Binding JogCommand}" CommandParameter="Z-" Style="{StaticResource JogButton}" Margin="0,0,10,0" />
                                <Button Content="Z +" Command="{Binding JogCommand}" CommandParameter="Z+" Style="{StaticResource JogButton}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="步長 Step (mm)" Style="{StaticResource ReadoutLabel}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding StepOptions}" SelectedItem="{Binding SelectedStep}"
                                      Width="120" MinHeight="30" Margin="0,0,0,10"
                                      Background="#101820" Foreground="#DCE3EA" BorderBrush="#31404F" />
                            <Button Content="回歸原點 HOME" Command="{Binding HomeCommand}" Style="{StaticResource DarkButton}" />
                            <Button Content="清除日誌" Command="{Binding ClearLogsCommand}" Style="{StaticResource DarkButton}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 即時狀態監控 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="即時狀態監控" Style="{StaticResource CardTitle}" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="X (mm)" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding CurrentX, StringFormat={}{0:F3}}" Style="{StaticResource ReadoutValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Y (mm)" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding CurrentY, StringFormat={}{0:F3}}" Style="{StaticResource ReadoutValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Z (mm)" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding CurrentZ, StringFormat={}{0:F3}}" Style="{StaticResource ReadoutValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="速度 (mm/s)" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding CurrentSpeed, StringFormat={}{0:F1}}" Style="{StaticResource ReadoutValue}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="作業模式" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding ModeText}" Style="{StaticResource ReadoutValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="機台狀態" Style="{StaticResource ReadoutLabel}" />
                                <TextBlock Text="{Binding MachineStateText}" Style="{StaticResource ReadoutValue}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 緊急停止 -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="緊急停止&#xA;E-STOP" Command="{Binding EmergencyStopCommand}" Style="{StaticResource EStopButton}" />
                        <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12">
                            按下後立即凍結所有軸向運動，並需送出 RESET 才能復歸。
                            <LineBreak />
                            此指令不等 ACK，直接送入佇列最前端，確保最低延遲。
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右欄：日誌主控台 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="通訊日誌 Log Console" Style="{StaticResource CardTitle}" Margin="0" DockPanel.Dock="Left" />
                        <CheckBox DockPanel.Dock="Right" Content="自動滾動" IsChecked="{Binding IsAutoScroll}"
                                  Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 附加行為負責自動捲到最后一行，Code-behind 保持乾淨 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Logs}"
                             behaviors:AutoScrollBehavior.AutoScroll="{Binding IsAutoScroll}"
                             Background="#0B1016" BorderBrush="#202A34" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Time}" Foreground="#5C6B7A" Width="92" />
                                    <TextBlock Text="{Binding Direction}" Width="40">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#7B8794" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                        <Setter Property="Foreground" Value="#4FC3F7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                        <Setter Property="Foreground" Value="#81C784" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="BAD">
                                                        <Setter Property="Foreground" Value="#FFB74D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="ERR">
                                                        <Setter Property="Foreground" Value="#EF5350" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" Foreground="#C8D3DF" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                            <Run Text="TX " /><Run Text="{Binding TransmitCount, Mode=OneWay}" Foreground="#4FC3F7" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                            <Run Text="RX " /><Run Text="{Binding ReceiveCount, Mode=OneWay}" Foreground="#81C784" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                            <Run Text="BAD " /><Run Text="{Binding MalformedCount, Mode=OneWay}" Foreground="#FFB74D" />
                        </TextBlock>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 狀態列 ============ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,6" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                <Run Text="狀態：" />
                <Run Text="{Binding ErrorText, Mode=OneWay}" Foreground="#EF9A9A" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
